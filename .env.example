# Copy to .env for the containerized Scion combo server (docker-compose.yml):
#   cp .env.example .env

# GID of the host 'docker' group — lets the container's scion user (uid 1000)
# access the mounted docker socket. Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# Registry holding the agent images, built & pushed via:
#   image-build/scripts/build-images.sh --registry <this> --push --target all
# The entrypoint applies it as the scion `image_registry` setting on start.
SCION_IMAGE_REGISTRY=ghcr.io/jvegold
